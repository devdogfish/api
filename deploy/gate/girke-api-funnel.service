[Unit]
Description=Girke API relay on Gate (Funnel :10000 -> vm api)
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=notify
DynamicUser=yes
EnvironmentFile=/etc/girke-api-funnel/funnel.env
StateDirectory=girke-api-funnel
StateDirectoryMode=0700
Environment=XDG_CONFIG_HOME=/var/lib/girke-api-funnel
Environment=XDG_DATA_HOME=/var/lib/girke-api-funnel
ExecStartPre=/usr/local/bin/caddy validate --config /etc/girke-api-funnel/Caddyfile --adapter caddyfile
ExecStart=/usr/local/bin/caddy run --config /etc/girke-api-funnel/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
